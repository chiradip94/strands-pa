# LLM Provider — choose one uncommented block
#LLM_BASE_URL="https://api.groq.com/openai/v1"
#LLM_API_KEY="gsk_..."
#LLM_MODEL="llama-3.1-8b-instant"

#LLM_BASE_URL="https://openrouter.ai/api/v1"
#LLM_API_KEY="sk-or-v1-..."
#LLM_MODEL="openrouter/free"

#LLM_BASE_URL="https://api.cloudflare.com/client/v4/accounts/.../ai/v1"
#LLM_API_KEY="..."
#LLM_MODEL="@cf/qwen/qwen2-72b-instruct"

LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="sk-..."
LLM_MODEL="gpt-4o"

# Langfuse observability (optional, app runs without)
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Qdrant vector store
QDRANT_URL="https://...us-east-2-0.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="..."
USER_COLLECTION_NAME="user-data"
QDRANT_MODEL="sentence-transformers/all-MiniLM-L6-v2"
QDRANT_VECTOR_SIZE="384"

# Browser Agent (Playwright) — headed by default (shows Firefox window via WSLg)
# BROWSER_HEADLESS=true
# Or connect to a remote Playwright MCP server:
# PLAYWRIGHT_MCP_URL="http://<ip>:8931/mcp"

# Cal.com — generate at https://app.cal.com/settings/developer/api-keys
CAL_API_KEY="cal_live_..."

# MongoDB for session persistence
MONGO_URI="mongodb+srv://..."
MONGO_DB="pa"
